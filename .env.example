# USPTO Open Data Portal key: https://data.uspto.gov/apis/getting-started (requires ID.me verification)
USPTO_API_KEY=
# Anthropic API key: https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: EPO Open Patent Services, for the Family tab (US + foreign family members and their citations).
# Free registration: https://developers.epo.org -> My Apps -> Add App (consumer key + secret)
EPO_OPS_KEY=
EPO_OPS_SECRET=
# Optional overrides
# Keep client or confidential work out of the repo: everything goes under private/ (git-ignored)
# FHA_WORKSPACE=private
FHA_MODEL=claude-sonnet-5
# FHA_CACHE_DIR=data/cache
# Cost accounting: every model call is logged here (see `fh-costs`)
# FHA_COST_LOG=data/costs/calls.jsonl
# Optional spending cap per run (one Analyze / Priority button press), in USD
# FHA_MAX_USD_PER_RUN=5
# Only needed on Windows if tesseract.exe is not on PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
